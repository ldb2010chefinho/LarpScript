// Um oi de cada linguagem que a LARP Script sabe fingir ser
print("Python")
console.log("JavaScript")
System.out.println("Java");
cout << "C++" << endl;
Console.WriteLine("C#");
println!("{}", "Rust");
fmt.Println("Go")
puts "Ruby"
echo "PHP";
println("Kotlin")
local lua = "Lua"
print(lua)
putStrLn "Haskell"
IO.puts "Elixir"
escreva("Português")
