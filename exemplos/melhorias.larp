// Novidades da etapa 4: do...while, objetos, generics, strings coladas e mais linguagens

let i = 0
do {
    console.log("volta " + i)
    i++
} while (i < 3);

let pessoa = {nome: "Ana", idade: 20, pets: ["Rex"]}
console.log(pessoa.nome, pessoa["idade"])
pessoa.idade = 21
const config = {
    tema: "escuro",   // comentário
    tamanho: { largura: 800, altura: 600 },
}
console.log(config.tamanho.largura, JSON.stringify(config))
let vazio = {}
vazio.x = 5
console.log(vazio)
// Python continua funcionando: set e dict comprehension
let s = {1, 2}
print(type(s).__name__)
d = {k: k * 2 for k in range(3)}
print(d)
lista = [
    1,
    2,
]
print(lista)

// ---- generics (Java, Rust)
List<String> nomes = new ArrayList<>();
nomes.add("Bia")
System.out.println(nomes.get(0) + " " + nomes.size())
Map<String, Integer> m = new HashMap<>();
public static <T> void mostrar(T x) {
    System.out.println("mostrar: " + x);
}
mostrar(42)
fn maior<T: PartialOrd>(a: T, b: T) -> T {
    if a > b {
        return a
    }
    return b
}
println!("{}", maior(3, 9))
int[] nums = {4, 5, 6};
console.log(nums.length)

// ---- strings coladas e mais personagens
console.log("strings " "coladas" ' juntas')
Console.WriteLine("Oi do C#")
putStrLn "Oi do Haskell"
IO.puts "Oi do Elixir"
