{
  "Oi (JavaScript)": {
    "prefix": "oi",
    "body": ["console.log(\"${1:Oi, LARP Script!}\")"],
    "description": "Imprime uma mensagem"
  },
  "Entrar no personagem": {
    "prefix": "larp",
    "body": ["larp as ${1|python,javascript,java,rust,go,ruby,php,lua,portugues,tungtung,tralalero|}:"],
    "description": "Troca de personagem (usado no --hardcore)"
  },
  "Função (JavaScript)": {
    "prefix": "fn",
    "body": ["function ${1:nome}(${2:a, b}) {", "    return ${3:a + b};", "}"],
    "description": "Função estilo JavaScript"
  },
  "Switch": {
    "prefix": "switch",
    "body": [
      "switch (${1:valor}) {",
      "    case ${2:1}:",
      "        ${3:puts \"um\"}",
      "        break;",
      "    default:",
      "        ${4:puts \"outro\"}",
      "}"
    ],
    "description": "switch/case"
  },
  "Repetir (Ruby)": {
    "prefix": "times",
    "body": ["${1:3}.times do |${2:i}|", "  puts \"volta #{${2:i}}\"", "end"],
    "description": "Loop estilo Ruby"
  },
  "Loop (JavaScript)": {
    "prefix": "for",
    "body": ["for (let ${1:i} = 0; ${1:i} < ${2:10}; ${1:i}++) {", "    ${3:console.log(${1:i})}", "}"],
    "description": "for estilo JavaScript"
  },
  "Página HTML + CSS": {
    "prefix": "pagina",
    "body": [
      "<style>",
      "  body { background: #1a1a2e; font-family: sans-serif; text-align: center; }",
      "  h1 { color: #ffd700; }",
      "</style>",
      "<h1>${1:Minha página em .larp}</h1>",
      "<p style=\"color: white;\">${2:Feita com LARP Script!}</p>"
    ],
    "description": "Página HTML com CSS (abre no navegador)"
  },
  "Brainfuck: imprime oi": {
    "prefix": "bfoi",
    "body": ["++++++++++[>+++++++++++<-]>+.------."],
    "description": "Brainfuck que imprime 'oi'"
  },
  "Do...while": {
    "prefix": "dowhile",
    "body": ["do {", "    ${1:console.log(i)}", "    ${2:i++}", "} while (${3:i < 3});"],
    "description": "Repete pelo menos uma vez e depois testa a condição"
  },
  "Objeto (JavaScript)": {
    "prefix": "objeto",
    "body": ["let ${1:pessoa} = {nome: \"${2:Ana}\", idade: ${3:20}}", "console.log(${1:pessoa}.nome)"],
    "description": "Objeto com chaves sem aspas; acesse com obj.chave"
  }
}
